{
  "name": "buu-get",
  "version": "1.0.0",
  "private": true,
  "description": "BUU GET monorepo — frontend (Quasar) + backend (NestJS)",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "prepare": "node -e \"const {execSync}=require('child_process');try{require.resolve('husky');execSync('husky',{stdio:'inherit'})}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=buu-get-back",
    "build:frontend": "npm run build --workspace=buu-get-front",
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=buu-get-front",
    "dev:backend": "npm run start:dev --workspace=buu-get-back",
    "start:backend": "npm run start:prod --workspace=buu-get-back",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm run lint --workspace=buu-get-back",
    "lint:frontend": "npm run lint --workspace=buu-get-front",
    "format": "npm run format --workspace=buu-get-back && npm run format --workspace=buu-get-front",
    "test": "npm run test --workspace=buu-get-back",
    "migration:run": "npm run migration:run --workspace=buu-get-back",
    "migration:generate": "npm run migration:generate --workspace=buu-get-back",
    "migration:revert": "npm run migration:revert --workspace=buu-get-back",
    "install:prod:backend": "npm ci --omit=dev --workspace=buu-get-back --ignore-scripts",
    "verify:prod:backend": "node scripts/verify-prod-deps.js ."
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7"
  }
}
