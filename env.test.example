# BUU GET — test / Playwright environment (copy to monorepo root as `.env.test`)
#
# Shared-DB mode (default for this project):
#   Point DB_* at the SAME MySQL schema you use for local dev (copy values from `.env`).
#   `npm run test:db:reset` only runs migrations + upserts RBAC test users — it does NOT
#   truncate unless you set ALLOW_DB_TRUNCATE=1.
#
# Never point at production. Prefer a disposable schema if you need wipe-and-reseed.

NODE_ENV=test
PORT=3000

# Database — same as local `.env` is OK (shared-DB mode)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=buu_get
DB_PASSWORD=
DB_NAME=buu_get

# Auth (min 16 chars) — can match local `.env`
JWT_SECRET=change-me-in-production-min-16-chars

# CORS
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# Optional: ThaiD identity callback redirect when API and SPA use different origins
FRONTEND_URL=http://localhost:9000

# Public certificate e-sign — ปิดไว้ก่อน (ตั้งเป็น true เมื่อพร้อมเรียก e-sign)
# Key Access จาก Lifelong configCert.KeyAccess (ค่าที่โค้ดเครื่องทดสอบใช้อยู่)
# provision key ของ route นี้ไม่มีใน constants.php
BUU_ESIGN_PUBLIC_CERT_ENABLED=false
BUU_ESIGN_PUBLIC_CERT_PATH=/service-api/e-sign.public.setaSign.SignElectronicSignature
BUU_ESIGN_PUBLIC_CERT_SCOPE=write
BUU_ESIGN_PUBLIC_CERT_KEY_ACCESS=384mcnj38q0384032r8wef38alknmve9
BUU_ESIGN_PUBLIC_CERT_PROVISION_KEY=oHh2z3Td9zrkpS3vGtBMbDQGSfDkbQNP

# ThaiD (DOPA) — อย่าใส่ client id / secret จริงลง git
# ค่าเริ่มต้นเป็น sandbox และจับคู่โฮสต์กับ callback ให้เองเมื่อไม่ override
# THAID_ENV=sandbox
# THAID_CLIENT_ID=
# THAID_CLIENT_SECRET=
# THAID_ISSUER=https://imauthsbx.bora.dopa.go.th
# THAID_REDIRECT_URI=https://buu-get-test.buu.ac.th/api/sandbox/callback
# ขอบเขต ThaiD ฟิกในโค้ดที่ DEFAULT_THAID_SCOPE ไม่ได้อ่านจาก env
# THAID_VERIFY_TYPE=pin

BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=50mb

# Playwright
PLAYWRIGHT_API_BASE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:9000

# Frontend (Quasar)
API_BASE_URL=http://localhost:3000/api

# Optional: skip DB prepare in Playwright globalSetup
# SKIP_TEST_DB_RESET=1

# Optional: DANGEROUS — wipe all tables before seed (not default)
# ALLOW_DB_TRUNCATE=1
