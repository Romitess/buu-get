# BUU GET — test / Playwright environment (copy to monorepo root as `.env.test`)
#
# Shared-DB mode (default for this project):
#   Point DB_* at the SAME MySQL schema you use for local dev (copy values from `.env`).
#   `npm run test:db:reset` only runs migrations + upserts RBAC test users — it does NOT
#   truncate unless you set ALLOW_DB_TRUNCATE=1.
#
# Never point at production. Prefer a disposable schema if you need wipe-and-reseed.

NODE_ENV=test
PORT=3000

# Database — same as local `.env` is OK (shared-DB mode)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=buu_get
DB_PASSWORD=
DB_NAME=buu_get

# Auth (min 16 chars) — can match local `.env`
JWT_SECRET=change-me-in-production-min-16-chars

# CORS
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=50mb

# Playwright
PLAYWRIGHT_API_BASE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:9000

# Frontend (Quasar)
API_BASE_URL=http://localhost:3000/api

# Optional: skip DB prepare in Playwright globalSetup
# SKIP_TEST_DB_RESET=1

# Optional: DANGEROUS — wipe all tables before seed (not default)
# ALLOW_DB_TRUNCATE=1
