{
  "name": "buu-get-front",
  "version": "0.0.1",
  "description": "BUU GET frontend application",
  "productName": "BUU GET",
  "author": "Tanakit Wongviroj <65160167@go.buu.ac.th>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "node -e \"const {execSync}=require('child_process');try{require.resolve('@quasar/app-vite/package.json');execSync('quasar prepare',{stdio:'inherit'})}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\""
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "apexcharts": "^5.15.0",
    "axios": "^1.13.2",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "quasar": "^2.16.0",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.0.3",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "2.4.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.11",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
