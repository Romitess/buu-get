{
  "name": "buu-get",
  "version": "1.0.0",
  "private": true,
  "description": "BUU GET monorepo — frontend (Quasar) + backend (NestJS)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "start:backend": "npm run start:prod --workspace=backend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "format": "npm run format --workspace=backend && npm run format --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "migration:run": "npm run migration:run --workspace=backend",
    "migration:generate": "npm run migration:generate --workspace=backend",
    "migration:revert": "npm run migration:revert --workspace=backend"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7"
  }
}
